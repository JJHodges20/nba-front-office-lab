# Copy this file to .env (git-ignored) and put your own values after the = signs.
# Never commit .env, and never put a value in this file.

# Your Ollama API key. Only the AI Research assistant's web search reads it.
FOL_OLLAMA_API_KEY=

# The key that signs the API's sign-in tokens: at least 32 characters, kept to yourself.
# Left empty, the API makes one in data/api/signing.key the first time it starts.
FOL_API_SECRET=

# Docker Compose only (compose.yaml); each is optional.
# Where the model is: empty is Compose's own Ollama container. To use the Ollama already
# running on this computer instead: http://host.docker.internal:11434
FOL_OLLAMA_HOST=
# The ports on this machine, where another program has 8000 or 8501 already.
FOL_API_PORT=
FOL_UI_PORT=
# Another data folder to mount in place of ./data - a copy, say.
FOL_DOCKER_DATA=
